{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@v1/*": [
        "../client/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
