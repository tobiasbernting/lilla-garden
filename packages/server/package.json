{
  "name": "@lilla-garden/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@lilla-garden/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
