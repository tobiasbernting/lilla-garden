DATABASE_URL=postgres://lilla_garden:lilla_garden@localhost:5435/lilla_garden
PORT=8080
# SEASON_OVERRIDE=jul   # halloween | jul | pask | midsommar | none
# Access control is on by default: the parent password guards /admin, where you invite and approve devices.
PARENT_PASSWORD=change-me-to-something-long
# ACCESS=open          # no access control at all – home network only
# PUBLIC_URL=https://gard.example.se   # public address (invite links, secure cookies, origin checks)
# TRUST_PROXY=1        # behind a tunnel/reverse proxy: read the visitor's IP from CF-Connecting-IP / X-Forwarded-For
# ADMIN_PORT=8081      # parent page on its own port only (keep it off the internet, e.g. a Tailscale address)
# NTFY_URL=http://ntfy.example.lan/lilla-garden   # push notifications when someone joins
